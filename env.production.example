# Production Environment Configuration
# Copy this to .env on your production server

# ========================================
# SERVER CONFIGURATION
# ========================================
# Use your production server IP or domain
SERVER_URL=http://74.208.173.203

# ========================================
# DATABASE
# ========================================
DATABASE_URL=postgresql://moretranz_user:your_secure_password@db:5432/moretranz

# ========================================
# JWT / AUTHENTICATION
# ========================================
# IMPORTANT: Change this to a secure random string in production!
SECRET_KEY=your-super-secret-key-change-this-in-production

# Desktop app tokens: 30 days (43200 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Refresh tokens: 90 days
REFRESH_TOKEN_EXPIRE_DAYS=90

ALGORITHM=HS256

# ========================================
# EMAIL CONFIGURATION
# ========================================
# Gmail Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Email processing settings
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
IMAP_SERVER=imap.gmail.com
EMAIL_PROCESSING_ENABLED=true

# Allowed email senders (comma-separated)
ALLOWED_SENDERS=sender1@example.com,sender2@example.com

# ========================================
# FILE STORAGE
# ========================================
ATTACHMENTS_FOLDER=/root/attachments
LOGS_FOLDER=/data/logs
PROCESSED_EMAILS_FILE=/data/logs/processed_emails.txt

# File upload limits
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,png,jpg,jpeg,gif,bmp,txt,html

# ========================================
# PRINTER CONFIGURATION (Not used on server)
# ========================================
BODY_PRINTER=BodyPrinter
ATTACHMENT_PRINTER=AttachmentPrinter

